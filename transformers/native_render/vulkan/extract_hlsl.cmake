# extract_hlsl.cmake - the Vulkan backend's HLSL, taken at build time from the Direct3D 12 backend's string literals in
# nr_d3d.cpp (cmake -DSRC=<nr_d3d.cpp> -DOUT=<header> -P extract_hlsl.cmake). One source for both backends: a change to
# a shader there reaches the Vulkan backend at the next build. Each literal's initializer is copied as it stands (its raw
# string pieces included), so the generated header compiles to exactly the same text.
if(NOT SRC OR NOT OUT)
    message(FATAL_ERROR "extract_hlsl.cmake: -DSRC=<nr_d3d.cpp> -DOUT=<header> are needed")
endif()
file(READ "${SRC}" text)
set(out "// Generated at build time by native_render/vulkan/extract_hlsl.cmake from native_render/nr_d3d.cpp: do not edit.\n")
string(APPEND out "// The Direct3D 12 backend's HLSL, the same text for the Vulkan backend (compiled to SPIR-V with DXC).\n")
string(APPEND out "#pragma once\n\nnamespace nr::vulkan::hlsl\n{\n")
# (SMAA's own source, SMAA.hlsl's pieces, is ext/smaa/smaa_hlsl.inc, which the backend includes as D3D12's does)
foreach(name kShader kProbeShader kCloudShader kBloomShader kToneShader kClarityShader kAaShader kSmaaPrelude kSmaaEntries)
    set(head "const char ${name}[] = R\"(")
    string(FIND "${text}" "${head}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "extract_hlsl.cmake: ${name} not found in ${SRC} (the HLSL moved? see docs/RENDERER_BACKEND.md section 8)")
    endif()
    string(LENGTH "const char ${name}[] = " skip)
    math(EXPR start "${at} + ${skip}")
    string(SUBSTRING "${text}" ${start} -1 rest)
    # (the literal ends at its last raw piece's ")" followed by a quote and the semicolon)
    string(FIND "${rest}" ")\";" end)
    if(end EQUAL -1)
        message(FATAL_ERROR "extract_hlsl.cmake: the end of ${name} not found in ${SRC}")
    endif()
    math(EXPR length "${end} + 2")
    string(SUBSTRING "${rest}" 0 ${length} initializer)
    string(APPEND out "    inline constexpr char ${name}[] = ${initializer};\n")
endforeach()
string(APPEND out "}\n")
# (written only when it differs: a change to nr_d3d.cpp outside its shaders leaves the header - and so the SPIR-V bake and
# the backend's files - as they were)
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL out)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${out}")
