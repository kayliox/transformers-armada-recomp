+bool PS2Vfs::resolveHostCase(const std::filesystem::path &base, const std::filesystem::path &relative,
+                             std::filesystem::path &result)
+{
+    result = (base / relative).lexically_normal();
+    std::error_code error;
+    const auto exact = std::filesystem::symlink_status(result, error);
+    if (!error && std::filesystem::exists(exact))
+        return true;
+    if (error && error != std::errc::no_such_file_or_directory && error != std::errc::not_a_directory)
+        return false;
+
+    const auto fold = [](unsigned char c) { return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c; };
+    result = base;
+    for (const auto &part : relative)
+    {
+        const auto direct = result / part;
+        error.clear();
+        const auto status = std::filesystem::symlink_status(direct, error);
+        if (!error && std::filesystem::exists(status))
+        {
+            result = direct;
+            continue;
+        }
+        if (error && error != std::errc::no_such_file_or_directory && error != std::errc::not_a_directory)
+            return false;
+
+        const std::string wanted = part.string();
+        std::filesystem::path match;
+        error.clear();
+        std::filesystem::directory_iterator it(result, error), end;
+        for (; !error && it != end; it.increment(error))
+        {
+            const std::string name = it->path().filename().string();
+            if (wanted.size() == name.size() &&
+                std::equal(wanted.begin(), wanted.end(), name.begin(),
+                           [&](unsigned char a, unsigned char b) { return fold(a) == fold(b); }))
+            {
+                // Windows cannot have case-colliding siblings; do not pick one to overwrite.
+                if (!match.empty())
+                    return false;
+                match = it->path();
+            }
+        }
+        if (error && error != std::errc::no_such_file_or_directory && error != std::errc::not_a_directory)
+            return false;
+        result = match.empty() ? direct : match;
+    }
+    result = result.lexically_normal();
+    return true;
+}
