         return c;
     }
 }
@@ -78,6 +81,11 @@
     g_stickSample = now;
 }
 
+void ps2_stick_response::setMenuShown(bool shown)
+{
+    g_stickMenu.store(shown, std::memory_order_relaxed);
+}
+
 namespace
 {
     constexpr uint8_t kPadAnalogMarker = 0x73;
@@ -972,7 +980,9 @@
     {
         std::lock_guard<std::mutex> lock(g_stickMutex);
         const bool fresh = std::chrono::steady_clock::now() - g_stickSample < std::chrono::milliseconds(500);
-        ps2_stick_response::map(lx, ly, rx, ry, response, fresh ? g_vehicleWeight : 0.0f, g_vehicleDeadzone, sonyPad);
+        // (TODO 274: no lift while a game menu's list is shown - a menu gets the stick itself)
+        ps2_stick_response::map(lx, ly, rx, ry, response, fresh ? g_vehicleWeight : 0.0f, g_vehicleDeadzone, sonyPad,
+                                !g_stickMenu.load(std::memory_order_relaxed));
     }
 
     // The triggers as the pad has them (gamepadTriggers).
