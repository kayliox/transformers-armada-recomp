+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -3885,6 +3885,9 @@ void PS2Runtime::run()
             {
                 DrawTexturePro(frameTex, srcRect, dstRect, Vector2{0.0f, 0.0f}, 0.0f, WHITE);
             }
+            // (only when a host asks for it - ps2_host_present::setOverlayLayers: everything drawn from here on, over the
