+++ b/ps2xRuntime/src/lib/ps2_host_display.cpp
@@ -1,4 +1,5 @@
 #include "runtime/ps2_host_display.h"
+#include "runtime/gs/gs_gpu.h" // (TODO 308: the GPU renderer's put-off start)
 
 #include <algorithm>
 #include <array>
@@ -743,7 +744,11 @@
 
     void setEmulatedDrawing(bool on)
     {
-        g_emulatedDrawing.store(on, std::memory_order_release);
+        const bool was = g_emulatedDrawing.exchange(on, std::memory_order_acq_rel);
+        // (TODO 308) The emulated drawing back after the host's renderer drew (its device lost, or its 2D handed back):
+        // the GPU renderer's put-off start is due now.
+        if (on && !was)
+            ps2_gpu::setStartDeferred(false); // (logs only when it was put off)
     }
 
