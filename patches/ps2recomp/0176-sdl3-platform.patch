+    void DrawTriangle(Vector2 v1, Vector2 v2, Vector2 v3, Color color)
+    {
+        if (!on())
+            return rl_DrawTriangle(v1, v2, v3, color);
+        if (ImDrawList *dl = list())
+            dl->AddTriangleFilled(ImVec2(v1.x, v1.y), ImVec2(v2.x, v2.y), ImVec2(v3.x, v3.y), col(color));
+    }
+    void DrawTexturePro(Texture2D texture, Rectangle source, Rectangle dest, Vector2 origin, float rotation, Color tint)
+    {
+        if (!on())
+            return rl_DrawTexturePro(texture, source, dest, origin, rotation, tint);
+        const PlatformTexture *t = textureOf(texture.id);
+        ImDrawList *dl = list();
+        if (!t || !t->handle || !dl || t->width <= 0 || t->height <= 0)
+            return;
+        const uint64_t id = t->external || !S().presenter.imguiTexture ? t->handle : S().presenter.imguiTexture(t->handle);
+        if (!id)
+            return;
+        if (rotation != 0.0f)
+            unsupported("DrawTexturePro with a rotation");
+        // (a negative source width or height flips it, as raylib's)
+        const float w = static_cast<float>(t->width), h = static_cast<float>(t->height);
+        ImVec2 uv0(source.x / w, source.y / h), uv1((source.x + std::fabs(source.width)) / w, (source.y + std::fabs(source.height)) / h);
+        if (source.width < 0.0f)
+            std::swap(uv0.x, uv1.x);
+        if (source.height < 0.0f)
+            std::swap(uv0.y, uv1.y);
+        const ImVec2 p0(dest.x - origin.x, dest.y - origin.y);
+        dl->AddImage(ImTextureRef(static_cast<ImTextureID>(id)), p0, ImVec2(p0.x + dest.width, p0.y + dest.height), uv0, uv1, col(tint));
+    }
+    Texture2D LoadTextureFromImage(Image image)
+    {
+        if (!on())
+            return rl_LoadTextureFromImage(image);
+        Texture2D out{};
+        State &s = S();
+        if (!image.data || image.width <= 0 || image.height <= 0 || !s.presenterOpen || !s.presenter.makeTexture)
+            return out;
+        Image rgba = image;
+        const bool converted = image.format != PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+        if (converted)
+        {
+            rgba = ImageCopy(image);
+            ImageFormat(&rgba, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+        }
+        PlatformTexture t;
+        t.width = rgba.width;
+        t.height = rgba.height;
+        t.live = true;
+        t.handle = s.presenter.makeTexture(t.width, t.height, false); // (raylib's default: nearest)
+        if (t.handle && s.presenter.updateTexture)
+            s.presenter.updateTexture(t.handle, rgba.data, t.width * 4);
+        if (converted)
+            UnloadImage(rgba);
+        if (!t.handle)
+            return out;
+        out.id = newTextureSlot(t);
+        out.width = t.width;
+        out.height = t.height;
+        out.mipmaps = 1;
+        out.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+        return out;
+    }
+    void UpdateTexture(Texture2D texture, const void *pixels)
+    {
+        if (!on())
+            return rl_UpdateTexture(texture, pixels);
+        if (const PlatformTexture *t = textureOf(texture.id); t && !t->external && pixels && S().presenter.updateTexture)
+            S().presenter.updateTexture(t->handle, pixels, t->width * 4);
+    }
+    void UnloadTexture(Texture2D texture)
+    {
+        if (!on())
+            return rl_UnloadTexture(texture);
+        if (PlatformTexture *t = textureOf(texture.id))
+        {
+            if (!t->external && S().presenter.dropTexture)
+                S().presenter.dropTexture(t->handle);
+            *t = PlatformTexture{};
+        }
+    }
+    void SetTextureFilter(Texture2D texture, int filter)
+    {
+        if (!on())
+            return rl_SetTextureFilter(texture, filter);
+        if (const PlatformTexture *t = textureOf(texture.id); t && !t->external && S().presenter.setTextureFilter)
+            S().presenter.setTextureFilter(t->handle, filter != TEXTURE_FILTER_POINT);
+    }
+    RenderTexture2D LoadRenderTexture(int width, int height)
+    {
+        if (!on())
+            return rl_LoadRenderTexture(width, height);
+        unsupported("LoadRenderTexture");
+        return RenderTexture2D{};
+    }
+    void UnloadRenderTexture(RenderTexture2D target)
+    {
+        if (!on())
+            return rl_UnloadRenderTexture(target);
+    }
+    void rlDrawRenderBatchActive(void)
+    {
+        if (!on())
+            return rl_rlDrawRenderBatchActive();
+    }
+}
+#endif
