+    int GetMouseX(void) { return on() ? static_cast<int>(S().mouse.x) : rl_GetMouseX(); }
+    int GetMouseY(void) { return on() ? static_cast<int>(S().mouse.y) : rl_GetMouseY(); }
+    Vector2 GetMousePosition(void) { return on() ? S().mouse : rl_GetMousePosition(); }
