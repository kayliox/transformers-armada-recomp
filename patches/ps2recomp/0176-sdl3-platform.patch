+    // SDL's scancodes (where a key is: what GLFW's key codes name too, US layout) as raylib's key codes.
+    int keyOf(SDL_Scancode sc)
+    {
+        if (sc >= SDL_SCANCODE_A && sc <= SDL_SCANCODE_Z)
+            return KEY_A + (sc - SDL_SCANCODE_A);
+        if (sc >= SDL_SCANCODE_1 && sc <= SDL_SCANCODE_9)
+            return KEY_ONE + (sc - SDL_SCANCODE_1);
+        if (sc >= SDL_SCANCODE_F1 && sc <= SDL_SCANCODE_F12)
+            return KEY_F1 + (sc - SDL_SCANCODE_F1);
+        if (sc >= SDL_SCANCODE_KP_1 && sc <= SDL_SCANCODE_KP_9)
+            return KEY_KP_1 + (sc - SDL_SCANCODE_KP_1);
+        switch (sc)
+        {
+        case SDL_SCANCODE_0: return KEY_ZERO;
+        case SDL_SCANCODE_RETURN: return KEY_ENTER;
+        case SDL_SCANCODE_ESCAPE: return KEY_ESCAPE;
+        case SDL_SCANCODE_BACKSPACE: return KEY_BACKSPACE;
+        case SDL_SCANCODE_TAB: return KEY_TAB;
+        case SDL_SCANCODE_SPACE: return KEY_SPACE;
+        case SDL_SCANCODE_MINUS: return KEY_MINUS;
+        case SDL_SCANCODE_EQUALS: return KEY_EQUAL;
+        case SDL_SCANCODE_LEFTBRACKET: return KEY_LEFT_BRACKET;
+        case SDL_SCANCODE_RIGHTBRACKET: return KEY_RIGHT_BRACKET;
+        case SDL_SCANCODE_BACKSLASH: return KEY_BACKSLASH;
+        case SDL_SCANCODE_SEMICOLON: return KEY_SEMICOLON;
+        case SDL_SCANCODE_APOSTROPHE: return KEY_APOSTROPHE;
+        case SDL_SCANCODE_GRAVE: return KEY_GRAVE;
+        case SDL_SCANCODE_COMMA: return KEY_COMMA;
+        case SDL_SCANCODE_PERIOD: return KEY_PERIOD;
+        case SDL_SCANCODE_SLASH: return KEY_SLASH;
+        case SDL_SCANCODE_CAPSLOCK: return KEY_CAPS_LOCK;
+        case SDL_SCANCODE_PRINTSCREEN: return KEY_PRINT_SCREEN;
+        case SDL_SCANCODE_SCROLLLOCK: return KEY_SCROLL_LOCK;
+        case SDL_SCANCODE_PAUSE: return KEY_PAUSE;
+        case SDL_SCANCODE_INSERT: return KEY_INSERT;
+        case SDL_SCANCODE_HOME: return KEY_HOME;
+        case SDL_SCANCODE_PAGEUP: return KEY_PAGE_UP;
+        case SDL_SCANCODE_DELETE: return KEY_DELETE;
+        case SDL_SCANCODE_END: return KEY_END;
+        case SDL_SCANCODE_PAGEDOWN: return KEY_PAGE_DOWN;
+        case SDL_SCANCODE_RIGHT: return KEY_RIGHT;
+        case SDL_SCANCODE_LEFT: return KEY_LEFT;
+        case SDL_SCANCODE_DOWN: return KEY_DOWN;
+        case SDL_SCANCODE_UP: return KEY_UP;
+        case SDL_SCANCODE_NUMLOCKCLEAR: return KEY_NUM_LOCK;
+        case SDL_SCANCODE_KP_DIVIDE: return KEY_KP_DIVIDE;
+        case SDL_SCANCODE_KP_MULTIPLY: return KEY_KP_MULTIPLY;
+        case SDL_SCANCODE_KP_MINUS: return KEY_KP_SUBTRACT;
+        case SDL_SCANCODE_KP_PLUS: return KEY_KP_ADD;
+        case SDL_SCANCODE_KP_ENTER: return KEY_KP_ENTER;
+        case SDL_SCANCODE_KP_0: return KEY_KP_0;
+        case SDL_SCANCODE_KP_PERIOD: return KEY_KP_DECIMAL;
+        case SDL_SCANCODE_KP_EQUALS: return KEY_KP_EQUAL;
+        case SDL_SCANCODE_APPLICATION: return KEY_KB_MENU;
+        case SDL_SCANCODE_LCTRL: return KEY_LEFT_CONTROL;
+        case SDL_SCANCODE_LSHIFT: return KEY_LEFT_SHIFT;
+        case SDL_SCANCODE_LALT: return KEY_LEFT_ALT;
+        case SDL_SCANCODE_LGUI: return KEY_LEFT_SUPER;
+        case SDL_SCANCODE_RCTRL: return KEY_RIGHT_CONTROL;
+        case SDL_SCANCODE_RSHIFT: return KEY_RIGHT_SHIFT;
+        case SDL_SCANCODE_RALT: return KEY_RIGHT_ALT;
+        case SDL_SCANCODE_RGUI: return KEY_RIGHT_SUPER;
+        default: return 0;
+        }
+    }
+
+    int mouseButtonOf(uint8_t b)
+    {
+        switch (b)
+        {
+        case SDL_BUTTON_LEFT: return MOUSE_BUTTON_LEFT;
+        case SDL_BUTTON_RIGHT: return MOUSE_BUTTON_RIGHT;
+        case SDL_BUTTON_MIDDLE: return MOUSE_BUTTON_MIDDLE;
+        case SDL_BUTTON_X1: return MOUSE_BUTTON_SIDE;
+        case SDL_BUTTON_X2: return MOUSE_BUTTON_EXTRA;
+        default: return -1;
+        }
+    }
+
+    // raylib's gamepad buttons from SDL's (raylib's GLFW platform's mapping: by place, A = the bottom face button).
+    void readPad(Pad &p)
+    {
+        static const struct { SDL_GamepadButton sdl; int raylib; } kMap[] = {
+            {SDL_GAMEPAD_BUTTON_NORTH, GAMEPAD_BUTTON_RIGHT_FACE_UP}, {SDL_GAMEPAD_BUTTON_EAST, GAMEPAD_BUTTON_RIGHT_FACE_RIGHT},
+            {SDL_GAMEPAD_BUTTON_SOUTH, GAMEPAD_BUTTON_RIGHT_FACE_DOWN}, {SDL_GAMEPAD_BUTTON_WEST, GAMEPAD_BUTTON_RIGHT_FACE_LEFT},
+            {SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, GAMEPAD_BUTTON_LEFT_TRIGGER_1}, {SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, GAMEPAD_BUTTON_RIGHT_TRIGGER_1},
+            {SDL_GAMEPAD_BUTTON_BACK, GAMEPAD_BUTTON_MIDDLE_LEFT}, {SDL_GAMEPAD_BUTTON_GUIDE, GAMEPAD_BUTTON_MIDDLE},
+            {SDL_GAMEPAD_BUTTON_START, GAMEPAD_BUTTON_MIDDLE_RIGHT}, {SDL_GAMEPAD_BUTTON_DPAD_UP, GAMEPAD_BUTTON_LEFT_FACE_UP},
+            {SDL_GAMEPAD_BUTTON_DPAD_RIGHT, GAMEPAD_BUTTON_LEFT_FACE_RIGHT}, {SDL_GAMEPAD_BUTTON_DPAD_DOWN, GAMEPAD_BUTTON_LEFT_FACE_DOWN},
+            {SDL_GAMEPAD_BUTTON_DPAD_LEFT, GAMEPAD_BUTTON_LEFT_FACE_LEFT}, {SDL_GAMEPAD_BUTTON_LEFT_STICK, GAMEPAD_BUTTON_LEFT_THUMB},
+            {SDL_GAMEPAD_BUTTON_RIGHT_STICK, GAMEPAD_BUTTON_RIGHT_THUMB},
+        };
+        for (const auto &m : kMap)
+            p.current[m.raylib] = SDL_GetGamepadButton(p.gamepad, m.sdl) ? 1u : 0u;
+        const auto stick = [&](SDL_GamepadAxis a) { return std::clamp(static_cast<float>(SDL_GetGamepadAxis(p.gamepad, a)) / 32767.0f, -1.0f, 1.0f); };
+        // (triggers as GLFW has them: -1 released .. 1 pressed)
+        const auto trigger = [&](SDL_GamepadAxis a) { return std::clamp(static_cast<float>(SDL_GetGamepadAxis(p.gamepad, a)) / 32767.0f, 0.0f, 1.0f) * 2.0f - 1.0f; };
+        p.axis[GAMEPAD_AXIS_LEFT_X] = stick(SDL_GAMEPAD_AXIS_LEFTX);
+        p.axis[GAMEPAD_AXIS_LEFT_Y] = stick(SDL_GAMEPAD_AXIS_LEFTY);
+        p.axis[GAMEPAD_AXIS_RIGHT_X] = stick(SDL_GAMEPAD_AXIS_RIGHTX);
+        p.axis[GAMEPAD_AXIS_RIGHT_Y] = stick(SDL_GAMEPAD_AXIS_RIGHTY);
+        p.axis[GAMEPAD_AXIS_LEFT_TRIGGER] = trigger(SDL_GAMEPAD_AXIS_LEFT_TRIGGER);
+        p.axis[GAMEPAD_AXIS_RIGHT_TRIGGER] = trigger(SDL_GAMEPAD_AXIS_RIGHT_TRIGGER);
+        // (raylib: the second triggers count as buttons past a tenth)
+        p.current[GAMEPAD_BUTTON_LEFT_TRIGGER_2] = p.axis[GAMEPAD_AXIS_LEFT_TRIGGER] > 0.1f ? 1u : 0u;
+        p.current[GAMEPAD_BUTTON_RIGHT_TRIGGER_2] = p.axis[GAMEPAD_AXIS_RIGHT_TRIGGER] > 0.1f ? 1u : 0u;
+    }
+
+    bool parseRgb(const char *v, uint8_t &r, uint8_t &g, uint8_t &b)
+    {
+        if (!v || std::strlen(v) != 6)
+            return false;
+        char *end = nullptr;
+        const unsigned long x = std::strtoul(v, &end, 16);
+        if (!end || *end)
+            return false;
+        r = static_cast<uint8_t>(x >> 16);
+        g = static_cast<uint8_t>(x >> 8);
+        b = static_cast<uint8_t>(x);
+        return true;
+    }
+
+    void padAdded(SDL_JoystickID id)
+    {
+        State &s = S();
+        for (const Pad &p : s.pads)
+            if (p.gamepad && p.id == id)
+                return;
+        for (int i = 0; i < kPads; ++i)
+        {
+            Pad &p = s.pads[i];
+            if (p.gamepad)
+                continue;
+            p = Pad{};
+            p.gamepad = SDL_OpenGamepad(id);
+            if (!p.gamepad)
+            {
+                std::fprintf(stderr, "[platform] SDL could not open gamepad %u: %s\n", static_cast<unsigned>(id), SDL_GetError());
+                return;
+            }
+            p.id = id;
+            const char *n = SDL_GetGamepadName(p.gamepad);
+            p.name = n ? n : "Gamepad";
+            const SDL_GamepadType type = SDL_GetGamepadType(p.gamepad);
+            std::fprintf(stderr, "[platform] gamepad %d: %s (%s)%s%s\n", i, p.name.c_str(), SDL_GetGamepadStringForType(type),
+                         SDL_GetBooleanProperty(SDL_GetGamepadProperties(p.gamepad), SDL_PROP_GAMEPAD_CAP_RUMBLE_BOOLEAN, false) ? ", rumble" : "",
+                         SDL_GetBooleanProperty(SDL_GetGamepadProperties(p.gamepad), SDL_PROP_GAMEPAD_CAP_RGB_LED_BOOLEAN, false) ? ", light" : "");
+            uint8_t r, g, b;
+            if (parseRgb(std::getenv("PS2X_SONYPAD_LIGHTBAR"), r, g, b))
+                SDL_SetGamepadLED(p.gamepad, r, g, b);
+            readPad(p);
+            std::memcpy(p.previous, p.current, sizeof(p.current));
+            return;
+        }
+        std::fprintf(stderr, "[platform] a fifth gamepad (%u) is not read\n", static_cast<unsigned>(id));
+    }
+
+    void padRemoved(SDL_JoystickID id)
+    {
+        for (int i = 0; i < kPads; ++i)
+        {
+            Pad &p = S().pads[i];
+            if (p.gamepad && p.id == id)
+            {
+                std::fprintf(stderr, "[platform] gamepad %d gone: %s\n", i, p.name.c_str());
+                SDL_CloseGamepad(p.gamepad);
+                p = Pad{};
+            }
+        }
+    }
+
+    void handle(const SDL_Event &e)
+    {
+        State &s = S();
+        switch (e.type)
+        {
+        case SDL_EVENT_QUIT:
+        case SDL_EVENT_WINDOW_CLOSE_REQUESTED:
+            s.shouldClose = true;
+            break;
+        case SDL_EVENT_KEY_DOWN:
+            if (const int k = keyOf(e.key.scancode); k > 0 && k < kKeys)
+            {
+                if (e.key.repeat)
+                    s.keyRepeat[k] = 1u;
+                else
+                {
+                    s.keyCurrent[k] = 1u;
+                    if (s.keyQueue.size() < 16u)
+                        s.keyQueue.push_back(k);
+                    if (k == s.exitKey)
+                        s.shouldClose = true;
+                }
+            }
+            break;
+        case SDL_EVENT_KEY_UP:
+            if (const int k = keyOf(e.key.scancode); k > 0 && k < kKeys)
+                s.keyCurrent[k] = 0u;
+            break;
+        case SDL_EVENT_TEXT_INPUT:
+            for (const unsigned char *t = reinterpret_cast<const unsigned char *>(e.text.text); t && *t;)
+            {
+                // (UTF-8 to code points)
+                int c = *t, n = 0;
+                if (c < 0x80) n = 0;
+                else if ((c & 0xE0) == 0xC0) { c &= 0x1F; n = 1; }
+                else if ((c & 0xF0) == 0xE0) { c &= 0x0F; n = 2; }
+                else { c &= 0x07; n = 3; }
+                ++t;
+                for (; n > 0 && *t; --n, ++t)
+                    c = (c << 6) | (*t & 0x3F);
+                if (s.charQueue.size() < 16u)
+                    s.charQueue.push_back(c);
+            }
+            break;
+        case SDL_EVENT_MOUSE_MOTION:
+            if (s.cursorCaptured)
+            {
+                s.mouse.x += e.motion.xrel;
+                s.mouse.y += e.motion.yrel;
+            }
+            else
+                s.mouse = Vector2{e.motion.x, e.motion.y};
+            break;
+        case SDL_EVENT_MOUSE_BUTTON_DOWN:
+        case SDL_EVENT_MOUSE_BUTTON_UP:
+            if (const int b = mouseButtonOf(e.button.button); b >= 0)
+                s.mouseCurrent[b] = e.type == SDL_EVENT_MOUSE_BUTTON_DOWN ? 1u : 0u;
+            break;
+        case SDL_EVENT_MOUSE_WHEEL:
+        {
+            const float flip = e.wheel.direction == SDL_MOUSEWHEEL_FLIPPED ? -1.0f : 1.0f;
+            s.wheel.x += e.wheel.x * flip;
+            s.wheel.y += e.wheel.y * flip;
+            break;
+        }
+        case SDL_EVENT_WINDOW_MOUSE_ENTER: s.cursorOnScreen = true; break;
+        case SDL_EVENT_WINDOW_MOUSE_LEAVE: s.cursorOnScreen = false; break;
+        case SDL_EVENT_WINDOW_FOCUS_GAINED: s.focused = true; break;
+        case SDL_EVENT_WINDOW_FOCUS_LOST: s.focused = false; break;
+        case SDL_EVENT_WINDOW_RESIZED:
+        case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
+            s.resized = true;
+            break;
+        case SDL_EVENT_GAMEPAD_ADDED: padAdded(e.gdevice.which); break;
+        case SDL_EVENT_GAMEPAD_REMOVED: padRemoved(e.gdevice.which); break;
+        default: break;
+        }
+        if (logOn() && (e.type == SDL_EVENT_WINDOW_FOCUS_GAINED || e.type == SDL_EVENT_WINDOW_FOCUS_LOST || e.type == SDL_EVENT_WINDOW_RESIZED ||
+                        e.type == SDL_EVENT_WINDOW_MINIMIZED || e.type == SDL_EVENT_WINDOW_RESTORED || e.type == SDL_EVENT_WINDOW_ENTER_FULLSCREEN ||
+                        e.type == SDL_EVENT_WINDOW_LEAVE_FULLSCREEN || e.type == SDL_EVENT_WINDOW_DISPLAY_CHANGED))
+            std::fprintf(stderr, "[platform] window event 0x%x\n", static_cast<unsigned>(e.type));
+    }
+
+    void noteSize()
+    {
+        State &s = S();
+        int w = 0, h = 0, pw = 0, ph = 0;
+        if (s.window)
+        {
+            SDL_GetWindowSize(s.window, &w, &h);
+            SDL_GetWindowSizeInPixels(s.window, &pw, &ph);
+        }
+        s.width.store(w, std::memory_order_relaxed);
+        s.height.store(h, std::memory_order_relaxed);
+        s.pixelWidth.store(pw, std::memory_order_relaxed);
+        s.pixelHeight.store(ph, std::memory_order_relaxed);
+    }
+
+    void noteScreenHz(bool force)
+    {
+        State &s = S();
+        const uint64_t now = nowNs();
+        if (!force && now - s.hzCheckedNs < 1000000000ull)
+            return;
+        s.hzCheckedNs = now;
+        float hz = 0.0f;
+        if (s.window)
+            if (const SDL_DisplayMode *m = SDL_GetCurrentDisplayMode(SDL_GetDisplayForWindow(s.window)))
+                hz = m->refresh_rate;
+        s.screenHz.store(hz, std::memory_order_relaxed);
+    }
+
+    // raylib's PollInputEvents: this poll's presses only (the queues, the wheel and "pressed" against the last poll).
+    void pump()
+    {
+        State &s = S();
+        if (!s.window)
+            return;
+        s.keyQueue.clear();
+        s.charQueue.clear();
+        std::memcpy(s.keyPrevious, s.keyCurrent, sizeof(s.keyCurrent));
+        std::memset(s.keyRepeat, 0, sizeof(s.keyRepeat));
+        std::memcpy(s.mousePrevious, s.mouseCurrent, sizeof(s.mouseCurrent));
+        s.wheel = Vector2{0.0f, 0.0f};
+        s.mousePrev = s.mouse;
+        s.resized = false;
+        for (Pad &p : s.pads)
+            std::memcpy(p.previous, p.current, sizeof(p.current));
+        const bool imgui = s.imguiReady && ImGui::GetCurrentContext() != nullptr;
+        SDL_Event e;
+        while (SDL_PollEvent(&e))
+        {
+            if (imgui)
+                ImGui_ImplSDL3_ProcessEvent(&e);
+            handle(e);
+        }
+        // (raylib: a minimised window's loop waits for it to come back, unless FLAG_WINDOW_ALWAYS_RUN)
+        while ((SDL_GetWindowFlags(s.window) & SDL_WINDOW_MINIMIZED) && !(s.config & FLAG_WINDOW_ALWAYS_RUN) && !s.shouldClose)
+            if (SDL_WaitEventTimeout(&e, 100))
+            {
+                if (imgui)
+                    ImGui_ImplSDL3_ProcessEvent(&e);
+                handle(e);
+            }
+        for (Pad &p : s.pads)
+            if (p.gamepad)
+                readPad(p);
+        noteSize();
+        noteScreenHz(false);
+    }
+
+    Pad *pad(int i)
+    {
+        if (i < 0) // (the first one: the one the pad code reads)
+            for (Pad &p : S().pads)
+                if (p.gamepad)
+                    return &p;
+        return i >= 0 && i < kPads && S().pads[i].gamepad ? &S().pads[i] : nullptr;
+    }
+
+    // ---- the window ------------------------------------------------------------------------------------------
+    void imguiHost();
+
+    bool makeWindow(int width, int height, const char *title)
+    {
+        State &s = S();
+        // Gamepads read while another window has the focus (as GLFW's: the pad code asks about the focus itself).
+        SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+        // The native DualSense / DualShock 4 code (ps2_sony_pad.h) owns Sony pads' HID unless PS2X_GAMEPAD_BACKEND=glfw
+        // (Steam Input, DS4Windows): SDL then leaves their HID alone (it would write their output reports too).
+        {
+            const char *b = std::getenv("PS2X_GAMEPAD_BACKEND");
+            s.sonyToNative = !(b && (std::strcmp(b, "glfw") == 0 || std::strcmp(b, "sdl") == 0));
+#if defined(_WIN32)
+            if (s.sonyToNative)
+            {
+                SDL_SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS4, "0");
+                SDL_SetHint(SDL_HINT_JOYSTICK_HIDAPI_PS5, "0");
+            }
+#endif
+        }
+        if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD))
+        {
+            std::fprintf(stderr, "[platform] SDL could not start: %s\n", SDL_GetError());
+            return false;
+        }
+        SDL_WindowFlags flags = static_cast<SDL_WindowFlags>(s.presenter.windowFlags);
+        if (s.config & FLAG_WINDOW_RESIZABLE) flags |= SDL_WINDOW_RESIZABLE;
+        if (s.config & FLAG_WINDOW_HIDDEN) flags |= SDL_WINDOW_HIDDEN;
+        if (s.config & FLAG_WINDOW_UNDECORATED) flags |= SDL_WINDOW_BORDERLESS;
+        if (s.config & FLAG_WINDOW_TOPMOST) flags |= SDL_WINDOW_ALWAYS_ON_TOP;
+        if (s.config & (FLAG_WINDOW_HIDDEN | FLAG_WINDOW_UNFOCUSED))
+            SDL_SetHint(SDL_HINT_WINDOW_ACTIVATE_WHEN_SHOWN, "0"); // (shown later without taking the focus from the desktop)
+        s.window = SDL_CreateWindow(title ? title : "", width, height, flags);
+        if (!s.window)
+        {
+            std::fprintf(stderr, "[platform] SDL could not make the window: %s\n", SDL_GetError());
+            return false;
+        }
+        s.focused = (SDL_GetWindowFlags(s.window) & SDL_WINDOW_INPUT_FOCUS) != 0;
+        s.startNs = s.frameStartNs = nowNs();
+        // ImGui: the overlays' context (the debugger's and a game's menus) and the 2D drawing's.
+        if (!ImGui::GetCurrentContext())
+            ImGui::CreateContext();
+        s.defaultFont = ImGui::GetIO().Fonts->AddFontDefault();
+        s.imguiReady = ImGui_ImplSDL3_InitForOther(s.window);
+        noteSize();
+        s.presenterOpen = s.presenter.open && s.presenter.open(s.window);
+        if (!s.presenterOpen)
+            std::fprintf(stderr, "[platform] %s cannot draw this window: no pictures\n", s.presenter.name);
+        imguiHost();
+        s.ready = true;
+        s.made.store(s.window, std::memory_order_release);
+        noteScreenHz(true);
+        int pw = 0, ph = 0;
+        SDL_GetWindowSizeInPixels(s.window, &pw, &ph);
+        std::fprintf(stderr, "[platform] SDL3 %d.%d.%d window %dx%d (%dx%d pixels) on %s, drawn by %s; screen %.2f Hz\n",
+                     SDL_VERSIONNUM_MAJOR(SDL_GetVersion()), SDL_VERSIONNUM_MINOR(SDL_GetVersion()), SDL_VERSIONNUM_MICRO(SDL_GetVersion()),
+                     width, height, pw, ph, SDL_GetCurrentVideoDriver(), s.presenter.name, static_cast<double>(S().screenHz.load()));
+        return true;
+    }
+
+    void closeWindow()
+    {
+        State &s = S();
+        if (!s.window)
+            return;
+        for (Pad &p : s.pads)
+            if (p.gamepad)
+            {
+                SDL_RumbleGamepad(p.gamepad, 0, 0, 0);
+                SDL_CloseGamepad(p.gamepad);
+                p = Pad{};
+            }
+        for (PlatformTexture &t : s.textures)
+            if (t.live && !t.external && s.presenter.dropTexture)
+                s.presenter.dropTexture(t.handle);
+        s.textures.clear();
+        if (s.presenterOpen && s.presenter.close)
+            s.presenter.close();
+        s.presenterOpen = false;
+        if (s.imguiReady && ImGui::GetCurrentContext())
+            ImGui_ImplSDL3_Shutdown(); // (the context stays: a game's code may still ask ImGui on its way out)
+        s.imguiReady = false;
+        s.made.store(nullptr, std::memory_order_release);
+        SDL_DestroyWindow(s.window);
+        s.window = nullptr;
+        s.ready = false;
+        SDL_Quit();
+    }
+
+    // Exclusive full screen at the window's size now (raylib's ToggleFullscreen), the desktop's refresh.
+    void setExclusive(bool want)
+    {
+        State &s = S();
+        if (want == s.exclusive || !s.window)
+            return;
+        if (want)
+        {
+            int w = 0, h = 0;
+            SDL_GetWindowSize(s.window, &w, &h);
+            const SDL_DisplayID d = SDL_GetDisplayForWindow(s.window);
+            const SDL_DisplayMode *desk = SDL_GetDesktopDisplayMode(d);
+            SDL_DisplayMode mode{};
+            if (SDL_GetClosestFullscreenDisplayMode(d, w, h, desk ? desk->refresh_rate : 0.0f, false, &mode))
+                SDL_SetWindowFullscreenMode(s.window, &mode);
+            else
+                SDL_SetWindowFullscreenMode(s.window, desk);
+            SDL_SetWindowFullscreen(s.window, true);
+            s.borderless = false;
+        }
+        else
+            SDL_SetWindowFullscreen(s.window, false);
+        s.exclusive = want;
+        SDL_SyncWindow(s.window);
+        noteSize();
+    }
+
+    // Borderless full screen (raylib's ToggleBorderlessWindowed): SDL's full screen at the desktop's mode.
+    void setBorderless(bool want)
+    {
+        State &s = S();
+        if (want == s.borderless || !s.window)
+            return;
+        if (want)
+        {
+            SDL_SetWindowFullscreenMode(s.window, nullptr);
+            SDL_SetWindowFullscreen(s.window, true);
+            s.exclusive = false;
+        }
+        else
+            SDL_SetWindowFullscreen(s.window, false);
+        s.borderless = want;
+        SDL_SyncWindow(s.window);
+        noteSize();
+    }
+
+    unsigned int windowStateNow()
+    {
+        State &s = S();
+        unsigned int f = s.config & (FLAG_VSYNC_HINT | FLAG_WINDOW_ALWAYS_RUN | FLAG_MSAA_4X_HINT | FLAG_INTERLACED_HINT);
+        if (!s.window)
+            return f;
+        const SDL_WindowFlags w = SDL_GetWindowFlags(s.window);
+        if (w & SDL_WINDOW_HIDDEN) f |= FLAG_WINDOW_HIDDEN;
+        if (w & SDL_WINDOW_MINIMIZED) f |= FLAG_WINDOW_MINIMIZED;
+        if (w & SDL_WINDOW_MAXIMIZED) f |= FLAG_WINDOW_MAXIMIZED;
+        if (!(w & SDL_WINDOW_INPUT_FOCUS)) f |= FLAG_WINDOW_UNFOCUSED;
+        if (w & SDL_WINDOW_ALWAYS_ON_TOP) f |= FLAG_WINDOW_TOPMOST;
+        if (w & SDL_WINDOW_BORDERLESS) f |= FLAG_WINDOW_UNDECORATED;
+        if (w & SDL_WINDOW_RESIZABLE) f |= FLAG_WINDOW_RESIZABLE;
+        if (s.exclusive) f |= FLAG_FULLSCREEN_MODE;
+        if (s.borderless) f |= FLAG_BORDERLESS_WINDOWED_MODE;
+        return f;
+    }
+
+    void applyWindowState(unsigned int flags, bool set)
+    {
+        State &s = S();
+        s.config = set ? (s.config | flags) : (s.config & ~flags);
+        if (!s.window)
+            return;
+        if (flags & FLAG_WINDOW_UNDECORATED) SDL_SetWindowBordered(s.window, !set);
+        if (flags & FLAG_WINDOW_TOPMOST) SDL_SetWindowAlwaysOnTop(s.window, set);
+        if (flags & FLAG_WINDOW_RESIZABLE) SDL_SetWindowResizable(s.window, set);
+        if (flags & FLAG_WINDOW_HIDDEN) set ? SDL_HideWindow(s.window) : SDL_ShowWindow(s.window);
+        if (flags & FLAG_WINDOW_MINIMIZED) set ? SDL_MinimizeWindow(s.window) : SDL_RestoreWindow(s.window);
+        if (flags & FLAG_WINDOW_MAXIMIZED) set ? SDL_MaximizeWindow(s.window) : SDL_RestoreWindow(s.window);
+        if (flags & FLAG_FULLSCREEN_MODE) setExclusive(set);
+        if (flags & FLAG_BORDERLESS_WINDOWED_MODE) setBorderless(set);
+    }
+
+    SDL_DisplayID displayAt(int monitor)
+    {
+        int n = 0;
+        SDL_DisplayID *ids = SDL_GetDisplays(&n);
+        const SDL_DisplayID d = ids && monitor >= 0 && monitor < n ? ids[monitor] : 0;
+        SDL_free(ids);
+        return d;
+    }
+
+    // ---- the drawing: one ImGui frame a picture ------------------------------------------------------------
+    ImDrawList *list()
+    {
+        return S().inFrame ? ImGui::GetBackgroundDrawList() : nullptr;
+    }
+
+    void beginPicture()
+    {
+        State &s = S();
+        const uint64_t now = nowNs();
+        s.frameTime = static_cast<double>(now - s.frameStartNs) / 1.0e9;
+        s.frameStartNs = now;
+        if (s.inFrame || !s.presenterOpen || !s.imguiReady || !ImGui::GetCurrentContext())
+            return;
+        if (s.presenter.newFrame && !s.presenter.newFrame())
+            return;
+        ImGui_ImplSDL3_NewFrame();
+        ImGui::NewFrame();
+        s.inFrame = true;
+        s.scissors = 0;
+    }
+
+    void endPicture()
+    {
+        State &s = S();
+        if (s.inFrame)
+        {
+            if (ImDrawList *dl = list())
+                for (; s.scissors > 0; --s.scissors)
+                    dl->PopClipRect();
+            ImGui::Render();
+            s.inFrame = false;
+            if (s.presenter.present)
+                s.presenter.present(ImGui::GetDrawData());
+        }
+        if (s.targetFps > 0)
+        {
+            const uint64_t want = 1000000000ull / static_cast<uint64_t>(s.targetFps), spent = nowNs() - s.frameStartNs;
+            if (spent < want)
+                SDL_DelayPrecise(want - spent);
+        }
+        pump();
+    }
+
+    ImFont *fontOf(const Font &f)
+    {
+        State &s = S();
+        const unsigned int id = f.texture.id;
+        if (id >= kFontIdBase && id - kFontIdBase < s.fonts.size() && s.fonts[id - kFontIdBase])
+            return s.fonts[id - kFontIdBase];
+        return s.defaultFont;
+    }
+
+    PlatformTexture *textureOf(unsigned int id)
+    {
+        State &s = S();
+        return id >= 1u && id <= s.textures.size() && s.textures[id - 1u].live ? &s.textures[id - 1u] : nullptr;
+    }
+
+    unsigned int newTextureSlot(const PlatformTexture &t)
+    {
+        State &s = S();
+        for (size_t i = 0; i < s.textures.size(); ++i)
+            if (!s.textures[i].live)
+            {
+                s.textures[i] = t;
+                return static_cast<unsigned int>(i + 1u);
+            }
+        s.textures.push_back(t);
+        return static_cast<unsigned int>(s.textures.size());
+    }
+
+    // The overlays' ImGui frames are this picture's: the host only styles ImGui (its frames are BeginDrawing's).
+    void imguiHost()
+    {
+        ps2_overlay::Host h;
+        h.name = "SDL3";
+        h.feedsInput = true;
+        h.setup = [](bool dark) { dark ? ImGui::StyleColorsDark() : ImGui::StyleColorsLight(); };
+        h.shutdown = [] {};
+        h.begin = [] {};
+        h.end = [] {};
+        ps2_overlay::setHost(h);
+    }
+
+    // The game's cursor shown or hidden: ImGui leaves the cursor alone while the game has it hidden.
+    void cursorToImGui()
+    {
+        if (!ImGui::GetCurrentContext())
+            return;
+        ImGuiIO &io = ImGui::GetIO();
+        if (S().cursorHidden || S().cursorCaptured)
+            io.ConfigFlags |= ImGuiConfigFlags_NoMouseCursorChange;
+        else
+            io.ConfigFlags &= ~ImGuiConfigFlags_NoMouseCursorChange;
+    }
+}
