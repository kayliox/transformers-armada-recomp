+    // ---- drawing --------------------------------------------------------------------------------------------
+    void BeginDrawing(void) { on() ? beginPicture() : rl_BeginDrawing(); }
+    void EndDrawing(void) { on() ? endPicture() : rl_EndDrawing(); }
+    void ClearBackground(Color color)
+    {
+        if (!on())
+            return rl_ClearBackground(color);
+        if (ImDrawList *dl = list(); dl && (color.r | color.g | color.b) != 0 && color.a != 0) // (black: the presenter's own clear)
+            dl->AddRectFilled(ImVec2(0.0f, 0.0f), ImGui::GetIO().DisplaySize, col(color));
+    }
+    void BeginTextureMode(RenderTexture2D target)
+    {
+        if (!on())
+            return rl_BeginTextureMode(target);
+        unsupported("BeginTextureMode");
+    }
+    void EndTextureMode(void)
+    {
+        if (!on())
+            return rl_EndTextureMode();
+    }
+    void BeginScissorMode(int x, int y, int width, int height)
+    {
+        if (!on())
+            return rl_BeginScissorMode(x, y, width, height);
+        if (ImDrawList *dl = list())
+        {
+            dl->PushClipRect(ImVec2(static_cast<float>(x), static_cast<float>(y)), ImVec2(static_cast<float>(x + width), static_cast<float>(y + height)), true);
+            ++S().scissors;
+        }
+    }
+    void EndScissorMode(void)
+    {
+        if (!on())
+            return rl_EndScissorMode();
+        if (ImDrawList *dl = list(); dl && S().scissors > 0)
+        {
+            dl->PopClipRect();
+            --S().scissors;
+        }
+    }
+    Image LoadImageFromScreen(void)
+    {
+        if (!on())
+            return rl_LoadImageFromScreen();
+        Image image{};
+        const int w = GetRenderWidth(), h = GetRenderHeight();
+        if (w <= 0 || h <= 0)
+            return image;
+        void *pixels = std::calloc(static_cast<size_t>(w) * h, 4u); // (UnloadImage frees it: raylib's RL_FREE is free)
+        if (!pixels)
+            return image;
+        if (!(S().presenter.readLastPicture && S().presenter.readLastPicture(pixels, w, h)))
+            for (size_t i = 3; i < static_cast<size_t>(w) * h * 4u; i += 4u)
+                static_cast<uint8_t *>(pixels)[i] = 255u; // (black)
+        image.data = pixels;
+        image.width = w;
+        image.height = h;
+        image.mipmaps = 1;
+        image.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+        return image;
+    }
