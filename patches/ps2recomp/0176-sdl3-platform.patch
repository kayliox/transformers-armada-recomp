+                g_keep = true; // (from now on: this first one is black - PS2X_SHOT_KEEP=1 keeps every picture)
+                std::fprintf(stderr, "[platform] a shot of the window: SDL's renderer keeps each picture from now on (PS2X_SHOT_KEEP=1 from the start)\n");
+            }
+            if (g_last.empty() || g_lastW != width || g_lastH != height)
+                return false;
