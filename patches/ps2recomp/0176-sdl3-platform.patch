+    unsigned int registerExternalTexture(uint64_t texture, int width, int height)
+    {
+        if (!on())
+            return 0u;
+        PlatformTexture t;
+        t.handle = texture;
+        t.width = width;
+        t.height = height;
+        t.external = t.live = true;
+        return newTextureSlot(t);
+    }
+
+    void updateExternalTexture(unsigned int id, uint64_t texture, int width, int height)
+    {
+        if (PlatformTexture *t = textureOf(id); t && t->external)
+        {
+            t->handle = texture;
+            t->width = width;
+            t->height = height;
+        }
+    }
+
+    void dropExternalTexture(unsigned int id)
+    {
+        if (PlatformTexture *t = textureOf(id); t && t->external)
