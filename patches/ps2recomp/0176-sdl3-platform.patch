+        return p && button > 0 && button < kPadButtons && p->current[button] && !p->previous[button];
+    }
+    bool IsGamepadButtonDown(int gamepad, int button)
+    {
+        if (!on())
+            return rl_IsGamepadButtonDown(gamepad, button);
+        const Pad *p = pad(gamepad);
+        return p && button > 0 && button < kPadButtons && p->current[button];
+    }
+    bool IsGamepadButtonReleased(int gamepad, int button)
+    {
+        if (!on())
+            return rl_IsGamepadButtonReleased(gamepad, button);
+        const Pad *p = pad(gamepad);
+        return p && button > 0 && button < kPadButtons && !p->current[button] && p->previous[button];
+    }
+    float GetGamepadAxisMovement(int gamepad, int axis)
+    {
+        if (!on())
+            return rl_GetGamepadAxisMovement(gamepad, axis);
+        // (raylib's: triggers -1 at rest, the rest 0; a value only past its resting one)
+        float value = (axis == GAMEPAD_AXIS_LEFT_TRIGGER || axis == GAMEPAD_AXIS_RIGHT_TRIGGER) ? -1.0f : 0.0f;
+        const Pad *p = pad(gamepad);
+        if (p && axis >= 0 && axis < kPadAxes)
+        {
+            const float movement = value < 0.0f ? p->axis[axis] : std::fabs(p->axis[axis]);
+            if (movement > value)
+                value = p->axis[axis];
+        }
+        return value;
+    }
+
+    bool IsMouseButtonPressed(int button)
+    {
+        if (!on())
+            return rl_IsMouseButtonPressed(button);
+        return button >= 0 && button < kMouseButtons && S().mouseCurrent[button] && !S().mousePrevious[button];
+    }
+    bool IsMouseButtonDown(int button)
+    {
+        if (!on())
+            return rl_IsMouseButtonDown(button);
+        return button >= 0 && button < kMouseButtons && S().mouseCurrent[button];
