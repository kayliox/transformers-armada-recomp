@@ -2,6 +2,7 @@
 // (ps2_host_present.h). This side is raylib's; the Direct3D side is ps2_host_present_dxgi.cpp
 // (raylib's names and windows.h's do not mix in one file).
 #include "runtime/ps2_host_present.h"
+#include "runtime/ps2_platform.h"
 
 #include "raylib.h"
 
@@ -33,7 +34,8 @@ namespace ps2_host_present
         bool requested()
         {
             const char *env = std::getenv("PS2X_PRESENT");
-            return !(env && std::strcmp(env, "gl") == 0);
+            // (SDL3's window has no OpenGL: its presenter shows the pictures - ps2_platform.h)
