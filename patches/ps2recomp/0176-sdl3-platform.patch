+    {
+        if (!on())
+            return rl_DrawRectangleRec(rec, color);
+        if (ImDrawList *dl = list())
+            dl->AddRectFilled(ImVec2(rec.x, rec.y), ImVec2(rec.x + rec.width, rec.y + rec.height), col(color));
+    }
+    void DrawRectangleLines(int posX, int posY, int width, int height, Color color)
+    {
+        if (!on())
+            return rl_DrawRectangleLines(posX, posY, width, height, color);
+        if (ImDrawList *dl = list())
+            dl->AddRect(ImVec2(static_cast<float>(posX), static_cast<float>(posY)), ImVec2(static_cast<float>(posX + width), static_cast<float>(posY + height)), col(color));
+    }
+    void DrawRectangleRounded(Rectangle rec, float roundness, int segments, Color color)
+    {
+        if (!on())
+            return rl_DrawRectangleRounded(rec, roundness, segments, color);
+        if (ImDrawList *dl = list())
+            dl->AddRectFilled(ImVec2(rec.x, rec.y), ImVec2(rec.x + rec.width, rec.y + rec.height), col(color),
+                              std::clamp(roundness, 0.0f, 1.0f) * std::min(rec.width, rec.height) * 0.5f);
+    }
+    void DrawRectangleRoundedLinesEx(Rectangle rec, float roundness, int segments, float lineThick, Color color)
+    {
+        if (!on())
+            return rl_DrawRectangleRoundedLinesEx(rec, roundness, segments, lineThick, color);
+        if (ImDrawList *dl = list())
