+/* raylib's window, input and 2D drawing calls that the runtime answers itself in a build with SDL3 (ps2_platform.h).
+ *
+ * Two lists of the same names, kept together:
+ * - PS2X_RAYLIB_PLATFORM_CALLS: for ps2_platform.cpp, which defines each call and forwards it to raylib's (rl_<name>)
+ *   or to SDL3's window, input and the overlays' ImGui drawing.
+ * - The #defines below: this file is a forced include on raylib's own sources (PS2X_RAYLIB_RENAME), so raylib defines
+ *   each of them as rl_<name> and its own calls between them stay its own.
+ * The linker keeps the two in step: a name in one list and not the other is either defined twice or not at all.
+ * raylib's other calls (images, fonts' files, audio, files, the clock's wait) stay raylib's under both platforms. */
+#ifndef PS2X_RAYLIB_CALLS_H
+#define PS2X_RAYLIB_CALLS_H
+
+#define PS2X_RAYLIB_PLATFORM_CALLS(X) \
+    X(InitWindow) X(CloseWindow) X(WindowShouldClose) X(IsWindowReady) X(IsWindowFullscreen) X(IsWindowHidden) \
+    X(IsWindowMinimized) X(IsWindowFocused) X(IsWindowResized) X(IsWindowState) X(SetWindowState) X(ClearWindowState) \
+    X(ToggleFullscreen) X(ToggleBorderlessWindowed) X(SetWindowTitle) X(SetWindowPosition) X(SetWindowSize) \
+    X(GetWindowHandle) X(GetScreenWidth) X(GetScreenHeight) X(GetRenderWidth) X(GetRenderHeight) X(GetMonitorCount) \
+    X(GetCurrentMonitor) X(GetMonitorPosition) X(GetMonitorWidth) X(GetMonitorHeight) X(GetMonitorRefreshRate) \
+    X(GetWindowPosition) X(ShowCursor) X(HideCursor) X(IsCursorHidden) X(EnableCursor) X(DisableCursor) \
+    X(IsCursorOnScreen) X(SetConfigFlags) X(SetTargetFPS) X(GetFrameTime) X(GetTime) X(PollInputEvents) X(SetExitKey) \
+    X(IsKeyPressed) X(IsKeyPressedRepeat) X(IsKeyDown) X(IsKeyReleased) X(IsKeyUp) X(GetKeyPressed) X(GetCharPressed) \
+    X(IsGamepadAvailable) X(GetGamepadName) X(IsGamepadButtonPressed) X(IsGamepadButtonDown) X(IsGamepadButtonReleased) \
+    X(GetGamepadAxisMovement) X(IsMouseButtonPressed) X(IsMouseButtonDown) X(IsMouseButtonReleased) X(GetMouseX) \
+    X(GetMouseY) X(GetMousePosition) X(GetMouseDelta) X(SetMousePosition) X(GetMouseWheelMove) X(GetMouseWheelMoveV) \
+    X(BeginDrawing) X(EndDrawing) X(ClearBackground) X(BeginTextureMode) X(EndTextureMode) X(BeginScissorMode) \
+    X(EndScissorMode) X(LoadImageFromScreen) X(DrawText) X(DrawTextEx) X(MeasureText) X(MeasureTextEx) \
+    X(GetFontDefault) X(LoadFontEx) X(UnloadFont) X(DrawRectangle) X(DrawRectangleRec) X(DrawRectangleLines) \
+    X(DrawRectangleRounded) X(DrawRectangleRoundedLinesEx) X(DrawLine) X(DrawLineEx) X(DrawCircle) X(DrawCircleV) \
+    X(DrawTriangle) X(DrawTexturePro) X(LoadTextureFromImage) X(UpdateTexture) X(UnloadTexture) X(SetTextureFilter) \
+    X(LoadRenderTexture) X(UnloadRenderTexture) X(rlDrawRenderBatchActive)
+
