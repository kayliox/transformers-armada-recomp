     return enabled;
 }
 
diff --git a/ps2xRuntime/src/lib/ps2_host_present.cpp b/ps2xRuntime/src/lib/ps2_host_present.cpp
index 6513d47..f622018 100644
--- a/ps2xRuntime/src/lib/ps2_host_present.cpp
