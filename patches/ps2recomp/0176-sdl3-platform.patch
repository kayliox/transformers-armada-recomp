         }
     }
 
diff --git a/ps2xRuntime/src/lib/ps2_platform.cpp b/ps2xRuntime/src/lib/ps2_platform.cpp
new file mode 100644
index 0000000..8a009cc
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_platform.cpp
@@ -0,0 +1,1671 @@
+// The window and its input, raylib's or SDL3's (ps2_platform.h). In a build with SDL3 (PS2X_HAS_SDL3) this file
+// defines raylib's window, input and 2D calls (ps2_raylib_calls.h) and forwards each one to raylib's own (rl_<name>)
+// or, under PS2X_PLATFORM=sdl3, answers it from SDL3 and the overlays' ImGui drawing.
+#include "runtime/ps2_platform.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace ps2_platform
+{
+    namespace
+    {
+        bool fromEnvironment()
+        {
+#if defined(PS2X_HAS_SDL3)
+            const char *v = std::getenv("PS2X_PLATFORM");
+            if (!v)
+                return false;
+            std::string s = v;
+            for (char &c : s)
+                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            if (s == "sdl3" || s == "sdl")
+                return true;
+            if (!s.empty() && s != "raylib")
+                std::fprintf(stderr, "[platform] PS2X_PLATFORM=%s is not one of raylib, sdl3: raylib\n", v);
+            return false;
+#else
+            if (const char *v = std::getenv("PS2X_PLATFORM"); v && (std::strcmp(v, "sdl3") == 0 || std::strcmp(v, "sdl") == 0))
+                std::fprintf(stderr, "[platform] PS2X_PLATFORM=%s: this build has no SDL3 (PS2X_SDL3): raylib\n", v);
+            return false;
+#endif
+        }
+    }
+
+    bool sdl3()
+    {
+        static const bool on = fromEnvironment();
+        return on;
+    }
+
+    const char *name()
+    {
+        return sdl3() ? "sdl3" : "raylib";
+    }
+}
+
+#if !defined(PS2X_HAS_SDL3)
+// A build without SDL3: raylib alone, nothing to forward.
+namespace ps2_platform
+{
+    void *sdlWindow() { return nullptr; }
+    void addSetting() {}
+    void setPresenter(const Presenter &) {}
+    const char *presenterName() { return ""; }
+    unsigned int registerExternalTexture(uint64_t, int, int) { return 0u; }
+    void updateExternalTexture(unsigned int, uint64_t, int, int) {}
+    void dropExternalTexture(unsigned int) {}
+    bool gamepadRumble(int, uint16_t, uint16_t) { return false; }
+    bool gamepadTriggerRumble(int, uint16_t, uint16_t) { return false; }
+    bool gamepadLed(int, uint8_t, uint8_t, uint8_t) { return false; }
+    const char *gamepadType(int) { return ""; }
+    float windowScreenHz() { return 0.0f; }
+}
+#else
+
+#include "raylib.h"
+#include "rlgl.h"
+#include "ps2_raylib_calls.h"
+
+#include "runtime/ps2_host_present.h"
+#include "runtime/ps2_overlay.h"
+#include "runtime/ps2_settings.h"
+
+#include "imgui.h"
+#include "backends/imgui_impl_sdl3.h"
+#include "backends/imgui_impl_sdlrenderer3.h"
+
+#include <SDL3/SDL.h>
+
+#include <chrono>
+#include <cmath>
+#include <mutex>
+#include <vector>
+
+// raylib's own definitions, renamed when raylib was compiled (ps2_raylib_calls.h): the same types as raylib.h's.
+extern "C"
+{
+#define PS2X_DECLARE_RAYLIB_OWN(name) decltype(::name) rl_##name;
+    PS2X_RAYLIB_PLATFORM_CALLS(PS2X_DECLARE_RAYLIB_OWN)
+#undef PS2X_DECLARE_RAYLIB_OWN
+}
+
+namespace
+{
+    bool on() { return ps2_platform::sdl3(); }
+
+    bool logOn()
+    {
+        static const bool v = [] { const char *e = std::getenv("PS2X_SDL_LOG"); return e && *e && *e != '0'; }();
+        return v;
+    }
+
+    void unsupported(const char *what)
+    {
+        static std::mutex m;
+        static std::vector<std::string> told;
+        std::lock_guard<std::mutex> lock(m);
+        if (std::find(told.begin(), told.end(), what) != told.end())
+            return;
+        told.emplace_back(what);
+        std::fprintf(stderr, "[platform] %s is not available with SDL3 (no OpenGL): left out\n", what);
+    }
+
+    ImU32 col(Color c) { return IM_COL32(c.r, c.g, c.b, c.a); }
+
+    // ---- SDL's 2D renderer: the default presenter ---------------------------------------------------------------
+    namespace sdlr
+    {
+        SDL_Renderer *g_renderer = nullptr;
+        int g_vsync = -99;
+        bool g_keep = false;            // the last picture kept for LoadImageFromScreen
+        std::vector<uint8_t> g_last;    // (RGBA rows)
+        int g_lastW = 0, g_lastH = 0;
+
+        bool open(void *window)
+        {
+            g_renderer = SDL_CreateRenderer(static_cast<SDL_Window *>(window), nullptr);
+            if (!g_renderer)
+            {
+                std::fprintf(stderr, "[platform] SDL could not make a renderer for the window: %s\n", SDL_GetError());
+                return false;
+            }
+            std::fprintf(stderr, "[platform] SDL's renderer draws the window (%s)\n", SDL_GetRendererName(g_renderer));
+            ImGui_ImplSDLRenderer3_Init(g_renderer);
+            const char *keep = std::getenv("PS2X_SHOT_KEEP");
+            g_keep = keep && *keep == '1';
+            return true;
+        }
+
+        void close()
+        {
+            if (!g_renderer)
+                return;
+            ImGui_ImplSDLRenderer3_Shutdown();
+            SDL_DestroyRenderer(g_renderer);
+            g_renderer = nullptr;
+        }
+
+        bool newFrame()
+        {
+            ImGui_ImplSDLRenderer3_NewFrame();
+            return true;
+        }
+
+        void present(void *drawData)
+        {
+            if (!g_renderer)
+                return;
+            // (VSync, the settings': ps2_host_present::sync - 1 always, 0 never, -1 by the screen)
+            if (const int want = ps2_host_present::sync(); want != g_vsync)
+            {
+                g_vsync = want;
+                const int mode = want == 1 ? 1 : want == 0 ? SDL_RENDERER_VSYNC_DISABLED : SDL_RENDERER_VSYNC_ADAPTIVE;
+                if (!SDL_SetRenderVSync(g_renderer, mode) && mode == SDL_RENDERER_VSYNC_ADAPTIVE)
+                    SDL_SetRenderVSync(g_renderer, 1);
+            }
+            SDL_SetRenderDrawColor(g_renderer, 0, 0, 0, 255);
+            SDL_RenderClear(g_renderer);
+            ImGui_ImplSDLRenderer3_RenderDrawData(static_cast<ImDrawData *>(drawData), g_renderer);
+            if (g_keep)
+            {
+                if (SDL_Surface *s = SDL_RenderReadPixels(g_renderer, nullptr))
+                {
+                    if (SDL_Surface *rgba = SDL_ConvertSurface(s, SDL_PIXELFORMAT_RGBA32))
+                    {
+                        g_lastW = rgba->w;
+                        g_lastH = rgba->h;
+                        g_last.resize(static_cast<size_t>(g_lastW) * g_lastH * 4u);
+                        for (int y = 0; y < g_lastH; ++y)
+                            std::memcpy(g_last.data() + static_cast<size_t>(y) * g_lastW * 4u,
+                                        static_cast<const uint8_t *>(rgba->pixels) + static_cast<size_t>(y) * rgba->pitch,
+                                        static_cast<size_t>(g_lastW) * 4u);
+                        SDL_DestroySurface(rgba);
+                    }
+                    SDL_DestroySurface(s);
+                }
+            }
+            SDL_RenderPresent(g_renderer);
+        }
+
+        uint64_t makeTexture(int width, int height, bool linear)
+        {
+            if (!g_renderer)
+                return 0u;
+            SDL_Texture *t = SDL_CreateTexture(g_renderer, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_STREAMING, width, height);
+            if (!t)
+            {
+                std::fprintf(stderr, "[platform] SDL could not make a %dx%d texture: %s\n", width, height, SDL_GetError());
+                return 0u;
+            }
+            SDL_SetTextureScaleMode(t, linear ? SDL_SCALEMODE_LINEAR : SDL_SCALEMODE_NEAREST);
+            SDL_SetTextureBlendMode(t, SDL_BLENDMODE_BLEND);
+            return reinterpret_cast<uint64_t>(t);
+        }
+
+        void updateTexture(uint64_t texture, const void *pixels, int pitch)
+        {
+            if (texture)
+                SDL_UpdateTexture(reinterpret_cast<SDL_Texture *>(texture), nullptr, pixels, pitch);
+        }
+
+        void setTextureFilter(uint64_t texture, bool linear)
+        {
+            if (texture)
+                SDL_SetTextureScaleMode(reinterpret_cast<SDL_Texture *>(texture), linear ? SDL_SCALEMODE_LINEAR : SDL_SCALEMODE_NEAREST);
