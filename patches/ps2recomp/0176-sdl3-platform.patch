+    bool gamepadRumble(int gamepad, uint16_t low, uint16_t high)
+    {
+        Pad *p = on() ? pad(gamepad) : nullptr;
+        // (a second at a time, renewed by each call while the game vibrates: SDL stops a pad that is not told again)
+        return p && SDL_RumbleGamepad(p->gamepad, low, high, 1000u);
+    }
+
+    bool gamepadTriggerRumble(int gamepad, uint16_t left, uint16_t right)
+    {
