+    {
+        if (!on())
+            return rl_DrawLineEx(startPos, endPos, thick, color);
+        if (ImDrawList *dl = list())
+            dl->AddLine(ImVec2(startPos.x, startPos.y), ImVec2(endPos.x, endPos.y), col(color), thick);
+    }
