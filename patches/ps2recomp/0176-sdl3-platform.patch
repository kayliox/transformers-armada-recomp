+    // Text: raylib's default font is ImGui's default font here; a font from LoadFontEx is ImGui's from the same file.
+    void DrawText(const char *text, int posX, int posY, int fontSize, Color color)
+    {
+        if (!on())
+            return rl_DrawText(text, posX, posY, fontSize, color);
+        if (ImDrawList *dl = list(); dl && text && S().defaultFont)
+            dl->AddText(S().defaultFont, static_cast<float>(std::max(fontSize, 10)), ImVec2(static_cast<float>(posX), static_cast<float>(posY)), col(color), text);
+    }
+    void DrawTextEx(Font font, const char *text, Vector2 position, float fontSize, float spacing, Color tint)
+    {
+        if (!on())
+            return rl_DrawTextEx(font, text, position, fontSize, spacing, tint);
+        if (ImDrawList *dl = list(); dl && text)
+            if (ImFont *f = fontOf(font))
+                dl->AddText(f, fontSize, ImVec2(position.x, position.y), col(tint), text);
+    }
+    int MeasureText(const char *text, int fontSize)
+    {
+        if (!on())
+            return rl_MeasureText(text, fontSize);
+        if (!text || !S().defaultFont || !ImGui::GetCurrentContext())
+            return 0;
+        return static_cast<int>(std::lround(S().defaultFont->CalcTextSizeA(static_cast<float>(std::max(fontSize, 10)), FLT_MAX, 0.0f, text).x));
+    }
+    Vector2 MeasureTextEx(Font font, const char *text, float fontSize, float spacing)
+    {
+        if (!on())
+            return rl_MeasureTextEx(font, text, fontSize, spacing);
+        ImFont *f = fontOf(font);
+        if (!text || !f || !ImGui::GetCurrentContext())
+            return Vector2{0.0f, 0.0f};
+        const ImVec2 size = f->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, text);
+        return Vector2{size.x, size.y};
+    }
+    Font GetFontDefault(void)
+    {
+        if (!on())
+            return rl_GetFontDefault();
+        Font f{};
+        f.baseSize = 10;
+        f.texture.id = kDefaultFontId;
+        return f;
+    }
+    Font LoadFontEx(const char *fileName, int fontSize, int *codepoints, int codepointCount)
+    {
+        if (!on())
+            return rl_LoadFontEx(fileName, fontSize, codepoints, codepointCount);
+        Font f = GetFontDefault();
+        if (!fileName || !ImGui::GetCurrentContext())
+            return f;
+        ImFont *font = ImGui::GetIO().Fonts->AddFontFromFileTTF(fileName, static_cast<float>(fontSize));
+        if (!font)
+            return f;
+        S().fonts.push_back(font);
+        f.baseSize = fontSize;
+        f.texture.id = kFontIdBase + static_cast<unsigned int>(S().fonts.size() - 1u);
+        return f;
+    }
+    void UnloadFont(Font font)
+    {
+        if (!on())
+            return rl_UnloadFont(font);
+        // (ImGui's atlas keeps it: a font is loaded once a session)
+    }
+
+    void DrawRectangle(int posX, int posY, int width, int height, Color color)
+    {
+        if (!on())
+            return rl_DrawRectangle(posX, posY, width, height, color);
+        if (ImDrawList *dl = list())
+            dl->AddRectFilled(ImVec2(static_cast<float>(posX), static_cast<float>(posY)), ImVec2(static_cast<float>(posX + width), static_cast<float>(posY + height)), col(color));
+    }
