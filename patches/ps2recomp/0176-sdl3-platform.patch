+                        std::clamp(roundness, 0.0f, 1.0f) * std::min(rec.width, rec.height) * 0.5f, 0, std::max(lineThick, 1.0f));
+    }
+    void DrawLine(int startPosX, int startPosY, int endPosX, int endPosY, Color color)
+    {
+        if (!on())
+            return rl_DrawLine(startPosX, startPosY, endPosX, endPosY, color);
+        if (ImDrawList *dl = list())
+            dl->AddLine(ImVec2(static_cast<float>(startPosX), static_cast<float>(startPosY)), ImVec2(static_cast<float>(endPosX), static_cast<float>(endPosY)), col(color));
+    }
