+            return;
+        }
         const uint64_t mask = plan().masks[r];
         if (mask == 0u)
             return;
@@ -219,7 +337,7 @@ namespace ps2_thread_placement
         s.help = "Auto: the game's busiest threads each get a processor core of their own, the ones that pass data to "
                  "each other on cores that share a cache. Can steady the frame rate on processors with 6 or more cores, "
                  "Ryzen especially. Off: Windows decides, as before. Takes a restart.";
-        s.choices = {{"off", "Off"}, {"auto", "Auto"}};
+        s.choices = {{"off", "Off"}, {"auto", "Auto"}}; // (best: an A/B by the environment only - TODO 312, no gain measured)
         s.defaultValue = "off";
 #if !defined(_WIN32)
         s.available = []() { return false; };
