+namespace
+{
+    // takeIdleBreakdown: off unless TF_HITCH_MS is set (read once).
+    bool idleBreakdownOn()
+    {
+        static const bool on = []()
+        {
+            const char *e = std::getenv("TF_HITCH_MS");
+            return e && std::atof(e) > 0.0;
+        }();
+        return on;
+    }
+    const char *const kIdleNames[] = {"no deadline", "EE timer", "Stop", "VBlankStart", "VBlankEnd", "Dmac", "ExternalWake", "Alarm"};
+}
+
+int EeScheduler::idleWhat(const EeEvent &event)
+{
+    if (event.type == EeEventType::Dmac && event.id < 16u)
+        return 16 + static_cast<int>(event.id);
+    return 2 + static_cast<int>(event.type);
+}
+
+void EeScheduler::noteIdleFor(int what, std::chrono::steady_clock::duration waited)
+{
+    if (!idleBreakdownOn() || what < 0 || what >= static_cast<int>(m_idleByNs.size()))
+        return;
+    std::lock_guard<std::mutex> lock(m_idleByMutex);
+    m_idleByNs[static_cast<size_t>(what)] += std::chrono::duration_cast<std::chrono::nanoseconds>(waited).count();
+}
+
+std::string EeScheduler::takeIdleBreakdown()
+{
+    if (!idleBreakdownOn())
+        return {};
+    std::array<int64_t, 40> by{};
+    {
+        std::lock_guard<std::mutex> lock(m_idleByMutex);
+        by = m_idleByNs;
+        m_idleByNs.fill(0);
+    }
+    std::string out;
+    char b[64];
+    for (size_t i = 0; i < by.size(); ++i)
+    {
+        if (by[i] < 100000) // (under 0.1 ms: left out)
+            continue;
+        if (i >= 16u)
+            std::snprintf(b, sizeof(b), "%sDmac%zu %.1f ms", out.empty() ? "" : ", ", i - 16u, by[i] / 1e6);
+        else
+            std::snprintf(b, sizeof(b), "%s%s %.1f ms", out.empty() ? "" : ", ", i < 8u ? kIdleNames[i] : "?", by[i] / 1e6);
+        out += b;
+    }
+    return out;
+}
