Subject: [PATCH] Runtime: vsprintf writes its whole result, not 255 characters (TODO 305 item 8)

The vsprintf stub cut every result at 255 characters ("keep guest stack temporaries from being overwritten"), and the
printf family read a format string up to 1024 bytes and a "%s" argument up to 512. A game's longer texts were cut
mid-word: the HQ's Situation text for Cybertron ended at "Autobot mis" (the game formats it into a 4096-byte buffer).
Now vsprintf writes the whole result as the C library does; a game can name the buffer size of a call site it knows
(setVsprintfBufferBytes, by the call's return address), and a longer result is then cut to that buffer with a log line
rather than run past it. Format strings and "%s" arguments are read up to 64 KB.

--- a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
@@ -735,6 +735,10 @@ namespace
         return false;
     }
 
+    // How much of a format string and of a "%s" argument the printf family reads (the C library has no limit; the
+    // game's texts are a few hundred characters, its biggest formatting buffer 4096 bytes).
+    constexpr size_t kPs2FormatReadBytes = 0x10000u;
+
     std::string readPs2CStringBounded(uint8_t *rdram, PS2Runtime *runtime, uint32_t addr, size_t maxLen = 512)
     {
         std::string out;
@@ -1240,7 +1244,7 @@ namespace
             [&cursor]()
             { return cursor.nextU64(); },
             [rdram, runtime](uint32_t addr)
-            { return readPs2CStringBounded(rdram, runtime, addr); });
+            { return readPs2CStringBounded(rdram, runtime, addr, kPs2FormatReadBytes); });
     }
 
     std::string formatPs2StringWithVaList(uint8_t *rdram, PS2Runtime *runtime, const char *format, uint32_t vaListAddr)
@@ -1254,7 +1258,7 @@ namespace
             [&cursor]()
             { return cursor.nextU64(); },
             [rdram, runtime](uint32_t addr)
-            { return readPs2CStringBounded(rdram, runtime, addr); });
+            { return readPs2CStringBounded(rdram, runtime, addr, kPs2FormatReadBytes); });
     }
 
     constexpr uint32_t kMaxStubWarningsPerName = 8;
--- a/ps2xRuntime/src/lib/Kernel/Stubs/LibC.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/LibC.cpp
@@ -1159,21 +1159,46 @@ namespace ps2_stubs
         return g_varArgSlotBytes.load(std::memory_order_relaxed);
     }
 
+    namespace
+    {
+        std::mutex g_vsprintfBufferMutex;
+        std::unordered_map<uint32_t, uint32_t> g_vsprintfBufferBytes; // return address -> the caller's buffer size
+    }
+
+    void setVsprintfBufferBytes(uint32_t returnAddress, uint32_t bytes)
+    {
+        std::lock_guard<std::mutex> lock(g_vsprintfBufferMutex);
+        g_vsprintfBufferBytes[returnAddress] = bytes;
+    }
+
     void vsprintf(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
         uint32_t str_addr = getRegU32(ctx, 4);      // $a0
         uint32_t format_addr = getRegU32(ctx, 5);   // $a1
         uint32_t va_list_addr = getRegU32(ctx, 6);  // $a2
-        constexpr size_t kSafeVsprintfBytes = 256u; // Keep guest stack temporaries from being overwritten.
-        const std::string formatOwned = readPs2CStringBounded(rdram, runtime, format_addr, 1024);
+        // The whole result, as the C library writes it: this used to stop at 255 characters, which cut every longer
+        // text the game puts together (a level's "Situation" text in the HQ ended mid-word: TODO 305). Call sites with a
+        // known buffer (setVsprintfBufferBytes) are kept inside it.
+        const std::string formatOwned = readPs2CStringBounded(rdram, runtime, format_addr, kPs2FormatReadBytes);
         int ret = -1;
 
         if (format_addr != 0)
         {
             std::string rendered = formatPs2StringWithVaList(rdram, runtime, formatOwned.c_str(), va_list_addr);
-            if (rendered.size() >= kSafeVsprintfBytes)
+            const uint32_t returnAddress = getRegU32(ctx, 31);
+            uint32_t limit = 0u;
+            {
+                std::lock_guard<std::mutex> lock(g_vsprintfBufferMutex);
+                if (const auto found = g_vsprintfBufferBytes.find(returnAddress); found != g_vsprintfBufferBytes.end())
+                    limit = found->second;
+            }
+            if (limit != 0u && rendered.size() >= limit)
             {
-                rendered.resize(kSafeVsprintfBytes - 1);
+                static std::atomic<uint32_t> told{0u};
+                if (told.fetch_add(1u) < 8u)
+                    std::cerr << "[vsprintf] " << rendered.size() << " characters for a " << limit << "-byte buffer (call at 0x"
+                              << std::hex << returnAddress << std::dec << "): cut to it" << std::endl;
+                rendered.resize(limit - 1u);
             }
             if (writeGuestBytes(rdram, runtime, str_addr, reinterpret_cast<const uint8_t *>(rendered.c_str()), rendered.size() + 1u))
             {
--- a/ps2xRuntime/src/lib/Kernel/Stubs/LibC.h
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/LibC.h
@@ -65,6 +65,10 @@ namespace ps2_stubs
     // them (a variadic function stores a2..t3 with sd and walks them 8 bytes at a time);
     // read 4 bytes at a time, such a list gives nothing but the first argument.
     void setVarArgSlotBytes(uint32_t bytes);
+    // vsprintf writes its whole result, as the C library does. A game's call site whose buffer is known can name its
+    // size here (by the call's return address): a longer result is cut to it, with a log line, instead of running past
+    // the buffer (which the console's own library would do).
+    void setVsprintfBufferBytes(uint32_t returnAddress, uint32_t bytes);
     uint32_t varArgSlotBytes();
     void __divdi3(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
 }
