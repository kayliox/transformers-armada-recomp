+    // A wheel notch bound to a pad input is a short press of it: down 60 ms, then up at least 45 ms before the next notch's
+    // press (so the game sees each one at 30-240 frames a second, however fast the wheel turns). Notches wait in a short queue
+    // (at most 4, none older than 0.4 s: a turn of the wheel no input takes is not pressed later).
+    std::atomic<int> g_wheelNotches[2];
+    std::atomic<int64_t> g_wheelLastNotchNs[2];
+    std::atomic<int64_t> g_wheelDownUntilNs[2], g_wheelUpUntilNs[2];
+    int64_t wheelNowNs()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    bool wheelDown(int button)
+    {
+        const int d = button == kMouseWheelUp ? 0 : 1;
+        const int64_t now = wheelNowNs();
+        if (now < g_wheelDownUntilNs[d].load(std::memory_order_relaxed))
+            return true;
+        if (now < g_wheelUpUntilNs[d].load(std::memory_order_relaxed))
+            return false;
+        if (g_wheelNotches[d].load(std::memory_order_relaxed) > 0 && now - g_wheelLastNotchNs[d].load(std::memory_order_relaxed) > 400000000ll)
+            g_wheelNotches[d].store(0, std::memory_order_relaxed);
+        int n = g_wheelNotches[d].load(std::memory_order_relaxed);
+        while (n > 0 && !g_wheelNotches[d].compare_exchange_weak(n, n - 1, std::memory_order_relaxed))
+        {
+        }
+        if (n <= 0)
+            return false;
+        g_wheelDownUntilNs[d].store(now + 60000000ll, std::memory_order_relaxed);
+        g_wheelUpUntilNs[d].store(now + 105000000ll, std::memory_order_relaxed);
+        return true;
+    }
+    bool mouseCodeDown(int code)
+    {
+        const int button = code - kMouseCode;
+        if (button == kMouseWheelUp || button == kMouseWheelDown)
+            return wheelDown(button);
+        return IsMouseButtonDown(button);
+    }
+
