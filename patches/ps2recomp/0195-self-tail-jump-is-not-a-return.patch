@@ -2079,6 +2107,11 @@ bool PS2Runtime::dispatchGuestBranch(uint8_t *rdram,
             reportMissingFunction(rdram, ctx, targetPc, sourcePc, kind, debugName);
         }
 
+        if (kind != GuestBranchKind::Return)
+        {
+            t_jumpTarget = targetPc; // (0195: for afterCall - a jump to the jumping function's own entry is no return)
+            t_jumpLevel = g_ps2DispatchLevels.level;
+        }
         ctx->pc = targetPc;
         return false;
     }
@@ -2311,6 +2344,11 @@ template <typename Thread>
 PS2_FORCEINLINE bool PS2Runtime::afterCall(uint8_t *rdram, R5900Context *ctx, Thread &thread, uint32_t targetPc,
                                            uint32_t entryPc, uint32_t fallthroughPc, uint32_t level)
 {
+    // (0195) The jump record is read once and cleared before any way out of a call's end - a stop, a thread's end
+    // (pc 0), the continuation below; dispatchUnwound clears it on a thread switch's unwind. (A call that ends on
+    // a lean path's fast return never made one that could match: its last transfer went to its own fallthrough.)
+    const bool jumpedToEntry = t_jumpTarget == entryPc && t_jumpLevel == level && entryPc != 0u;
+    t_jumpTarget = 0u;
     if (isStopRequested() || ctx->pc == 0u)
     {
         return false;
@@ -2319,9 +2357,13 @@ PS2_FORCEINLINE bool PS2Runtime::afterCall(uint8_t *rdram, R5900Context *ctx, Th
     // A callee that leaves pc at its own entry normally just did not set it
     // (e.g. a stub) and has returned; but one that yielded at a loop back to
     // its first instruction has not, and must be resumed there.
+    // (0195) ... unless it just JUMPED there (a tail call of itself through a pointer): then it goes on below.
     if (ctx->pc == entryPc && !(m_eeScheduler && m_eeScheduler->unwindingForCheckpoint()))
     {
-        ctx->pc = fallthroughPc;
+        if (jumpedToEntry && g_selfJumpLog)
+            noteSelfJump(entryPc, fallthroughPc, g_selfJump);
+        if (!(jumpedToEntry && g_selfJump))
+            ctx->pc = fallthroughPc;
     }
 
     // (FPS) A call left unfinished with nothing due: the callee went on somewhere else - a switch's
@@ -2340,6 +2382,7 @@ PS2_FORCEINLINE bool PS2Runtime::afterCall(uint8_t *rdram, R5900Context *ctx, Th
     {
         for (uint32_t l = 1u; l < level; ++l)
             g_ps2DispatchLevels.resumedByDispatcher[l] = true;
+        uint32_t selfJumps = 0u; // (0195: jumps of one function to its own entry in this go)
         while (ctx->pc != fallthroughPc)
         {
             if (m_eeScheduler->unwindingForCheckpoint())
@@ -2351,9 +2394,29 @@ PS2_FORCEINLINE bool PS2Runtime::afterCall(uint8_t *rdram, R5900Context *ctx, Th
                 return false; // (the dispatcher's own checkpoint before entering it)
             const uint32_t continuePc = ctx->pc;
             pushDispatchPc(thread.history, continuePc);
+            t_jumpTarget = 0u;
             fn(rdram, ctx, this);
-            if (isStopRequested() || ctx->pc == 0u || ctx->pc == continuePc)
-                return false; // (the dispatcher's business: a thread's end, a loop that yielded at its start)
+            const bool jumpedAgain = t_jumpTarget == continuePc && t_jumpLevel == level; // (0195: read once, cleared)
+            t_jumpTarget = 0u;
+            if (isStopRequested() || ctx->pc == 0u)
+                return false; // (the dispatcher's business: a thread's end)
+            if (ctx->pc == continuePc)
+            {
+                // (0195) it jumped to its own entry again (a chain of three or more): entered again here, as any
+                // other address it could have gone on at; else a loop that yielded at its start - the dispatcher's
+                if (g_selfJump && jumpedAgain && !m_eeScheduler->unwindingForCheckpoint())
+                {
+                    if (g_selfJumpLog)
+                        noteSelfJump(continuePc, fallthroughPc, true);
+                    if (++selfJumps < kSelfJumpGuard)
+                        continue;
+                    static std::atomic<bool> told{false};
+                    if (!told.exchange(true))
+                        std::fprintf(stderr, "[runtime] %08x jumped to its own entry %u times in one go: left to the dispatcher (a guest loop?)\n",
+                                     continuePc, kSelfJumpGuard);
+                }
+                return false;
+            }
         }
         // This call's caller goes on here: the dispatcher's checkpoint before entering it again.
         if (m_eeScheduler->checkpointDue(EeScheduler::kGuestDispatchCycles))
@@ -2414,6 +2477,7 @@ PS2_NOINLINE bool PS2Runtime::callEnd(uint8_t *rdram, R5900Context *ctx, uint32_
 void PS2Runtime::dispatchUnwound() noexcept
 {
     g_ps2DispatchLevels.level = 0u;
+    t_jumpTarget = 0u; // (0195: a thread switch's unwind leaves no jump record behind)
 }
 
