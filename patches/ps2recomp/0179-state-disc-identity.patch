+void PS2IopHostAdapter::saveStateFiles(ps2x::StateWriter &out) const
+{
+    const std::string cdImage = PS2Runtime::getIoPaths().cdImage.string();
+    std::lock_guard<std::mutex> lock(m_hostFileMutex);
+    std::map<uint64_t, const HostFile *> ordered;
+    for (const auto &[handle, file] : m_hostFiles)
+        ordered.emplace(handle, &file);
+    out.u64(ordered.size());
+    for (const auto &[handle, file] : ordered)
+    {
+        out.u64(handle);
+        out.string(!cdImage.empty() && file->path == cdImage ? std::string(kStateCdImageToken) : file->path);
+        StateFileIdentity identity;
+        const bool checked = !stateFileIsCard(file->path) && stateFileIdentity(std::filesystem::path(file->path), identity);
+        out.u8(checked ? 1u : 0u);
+        out.u64(identity.size);
+        out.u64(identity.hash);
+    }
+}
+
+bool PS2IopHostAdapter::checkStateFiles(ps2x::StateReader &in, std::string &reason)
+{
+    const std::string cdImage = PS2Runtime::getIoPaths().cdImage.string();
+    std::lock_guard<std::mutex> lock(m_hostFileMutex);
+    m_stateFileMatches.clear();
+    const size_t files = in.count(29u);
+    for (size_t i = 0; i < files && in.ok(); ++i)
+    {
+        const uint64_t handle = in.u64();
+        std::string path = in.string();
+        const bool checked = in.u8() != 0u;
+        StateFileIdentity want;
+        want.size = in.u64();
+        want.hash = in.u64();
+        if (!in.ok())
+            break;
+        if (path == kStateCdImageToken)
+            path = cdImage;
+        if (!checked)
+            continue;
+        // The file this run reads for that path (its disc's), and failing that the path as it is.
+        std::filesystem::path here = relocateStateHostFile(std::filesystem::path(path), true);
+        std::error_code error;
+        if (!std::filesystem::is_regular_file(here, error))
+            here = relocateStateHostFile(std::filesystem::path(path));
+        StateFileIdentity have;
+        if (!stateFileIdentity(here, have))
+        {
+            m_stateFileMatches.clear();
+            reason = "it needs a game file that is not here (" + std::filesystem::path(path).filename().string() + ")";
+            return false;
+        }
+        if (have.size != want.size || have.hash != want.hash)
+        {
+            m_stateFileMatches.clear();
+            reason = "made with other game files: " + std::filesystem::path(path).filename().string() +
+                     " here is not the one it was made with (a state made with mods loads only with the same mods, and "
+                     "one made without mods only without them)";
+            return false;
+        }
+        m_stateFileMatches[handle] = here.string();
+    }
+    if (!in.ok())
+    {
+        m_stateFileMatches.clear();
+        reason = "section DISC does not match this build";
+        return false;
+    }
+    return true;
+}
+
+void PS2IopHostAdapter::forgetStateFiles()
+{
+    std::lock_guard<std::mutex> lock(m_hostFileMutex);
+    m_stateFileMatches.clear();
 }
 
