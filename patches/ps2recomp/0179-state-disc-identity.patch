+    struct StateFileIdentity
+    {
+        uint64_t size = 0u;
+        uint64_t hash = 0u;
+    };
+
+    // Worked out once per file and run (keyed on its path, size and time written): an F5 / F9 reads no file twice.
+    bool stateFileIdentity(const std::filesystem::path &path, StateFileIdentity &identity)
+    {
+        std::error_code error;
+        identity.size = std::filesystem::file_size(path, error);
+        if (error)
+            return false;
+        const auto written = std::filesystem::last_write_time(path, error);
+        if (error)
+            return false;
+        static std::mutex cacheMutex;
+        static std::map<std::filesystem::path, std::pair<std::pair<uint64_t, std::filesystem::file_time_type>, uint64_t>> cache;
+        {
+            std::lock_guard<std::mutex> lock(cacheMutex);
+            if (const auto found = cache.find(path); found != cache.end() && found->second.first.first == identity.size &&
+                                                     found->second.first.second == written)
+            {
+                identity.hash = found->second.second;
+                return true;
+            }
+        }
+#if defined(_WIN32)
+        std::FILE *stream = ::_wfopen(path.c_str(), L"rb");
+#else
+        std::FILE *stream = std::fopen(path.string().c_str(), "rb");
+#endif
+        if (!stream)
+            return false;
+        constexpr uint64_t kEnd = 64u * 1024u;
+        uint64_t hash = 14695981039346656037ull; // FNV-1a
+        for (int i = 0; i < 8; ++i)
+            hash = (hash ^ ((identity.size >> (i * 8)) & 0xFFu)) * 1099511628211ull;
+        std::vector<uint8_t> buffer(static_cast<size_t>(std::min(kEnd, identity.size)));
+        bool ok = true;
+        for (const uint64_t offset : {uint64_t{0u}, identity.size - buffer.size()})
+        {
+            if (buffer.empty())
+                break;
+#if defined(_WIN32)
+            ok = _fseeki64(stream, static_cast<int64_t>(offset), SEEK_SET) == 0;
+#else
+            ok = fseeko(stream, static_cast<off_t>(offset), SEEK_SET) == 0;
+#endif
+            ok = ok && std::fread(buffer.data(), 1u, buffer.size(), stream) == buffer.size();
+            if (!ok)
+                break;
+            for (const uint8_t byte : buffer)
+                hash = (hash ^ byte) * 1099511628211ull;
+        }
+        std::fclose(stream);
+        identity.hash = hash;
+        if (ok)
+        {
+            std::lock_guard<std::mutex> lock(cacheMutex);
+            cache[path] = {{identity.size, written}, hash};
+        }
+        return ok;
+    }
