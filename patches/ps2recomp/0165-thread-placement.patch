@@ -0,0 +1,45 @@
+#ifndef PS2_THREAD_PLACEMENT_H
+#define PS2_THREAD_PLACEMENT_H
+
+// Which processors the busy threads run on (Windows; elsewhere nothing happens).
+//
+// The game is a pipeline of threads handing a lot of data to each other: the game (EE) thread writes a frame into
+// guest memory; the VIF1 thread and the native renderer's read thread take it from there; the render thread builds
+// the GPU's work. On a processor whose cores share an L3 cache in groups (Zen 2: an L3 per 3-4 cores), where the
+// scheduler puts them matters: in another recompilation of this game, the EE and geometry threads on one L3 group and
+// the GS threads on the other, none on core 0, took a Ryzen 5 3600 from ~37 ms a frame (unsteady) to a steady
+// 33.3 ms.
+//
+// PS2X_THREAD_PLACEMENT (a setting, Graphics page; read at start):
+//   off  (default) nothing is placed: exactly as without this file.
+//   auto from the processor topology, with 6 or more cores (the fast ones, on a CPU with performance and efficiency
+//        cores) in processor group 0:
+//        two or more L3 groups - EE, VIF1 and the native renderer's read thread on three cores of an L3 group without
+//          core 0; the render thread and the GS feed on the second and third cores of core 0's group;
+//        one L3 - EE, VIF1, read, render and GS feed on cores 1 to 5.
+//        Each may run on both SMT threads of its core. The helpers (sound mixer, movie decoder, HD texture uploads and
+//        loaders, the controller thread) may run anywhere but the EE's and the render thread's cores.
+// PS2X_THREAD_CPUS=<ee>,<vif1>,<read>,<render>,<gsfeed> (with auto, for trying placements on a bench): a logical
+// processor for each instead (its core's SMT threads with it); negative or left out: auto's choice for that one.
+namespace ps2_thread_placement
+{
+    enum class Role : int
+    {
+        Ee = 0,     // the game thread
+        Vif1,       // ps2_vif1_thread.cpp's worker
+        GsFeed,     // ps2_vif1_thread.cpp's GS feed
+        RenderRead, // the native renderer's guest-memory reader
+        Render,     // the native renderer's render thread
+        Helper,     // sound mixer, movie decoder, HD texture uploads, controller thread
+        Count
+    };
+
+    // From the thread itself, as it starts. Does nothing with PS2X_THREAD_PLACEMENT off (or unset), on a machine
+    // auto leaves alone, and outside Windows.
+    void place(Role role);
+
+    // The setting for the panel (from ps2_settings::addRuntimeSettings).
+    void addSetting();
+}
+
+#endif
